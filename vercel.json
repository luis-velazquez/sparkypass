{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install --legacy-peer-deps",
  "regions": ["iad1"],
  "crons": [
    {
      "path": "/api/cron/sparky-notify",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/cron/hard-delete",
      "schedule": "0 6 * * *"
    }
  ]
}
